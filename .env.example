ONTOFOUNDRY_ENVIRONMENT=development
# Copy to apps/api/.env. All relative paths are relative to apps/api.
ONTOFOUNDRY_DATABASE_URL=postgresql+psycopg://ontofoundry:ontofoundry@127.0.0.1:5432/ontofoundry
ONTOFOUNDRY_DATA_DIR=./.data/files
ONTOFOUNDRY_AUTO_CREATE_SCHEMA=false
ONTOFOUNDRY_SEED_DEMO=true
ONTOFOUNDRY_AUTH_MODE=dev
ONTOFOUNDRY_SESSION_SECRET=development-only-replace-before-production
ONTOFOUNDRY_COOKIE_SECURE=false
ONTOFOUNDRY_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Required when ONTOFOUNDRY_AUTH_MODE=oauth
ONTOFOUNDRY_OAUTH_PROVIDER=internal
ONTOFOUNDRY_OAUTH_AUTHORIZE_URL=
ONTOFOUNDRY_OAUTH_TOKEN_URL=
ONTOFOUNDRY_OAUTH_USER_INFO_URL=
ONTOFOUNDRY_OAUTH_CLIENT_ID=
ONTOFOUNDRY_OAUTH_CLIENT_SECRET=
ONTOFOUNDRY_OAUTH_REDIRECT_URI=http://127.0.0.1:5174/api/v1/auth/callback

ONTOFOUNDRY_ANTHROPIC_BASE_URL=
ONTOFOUNDRY_ANTHROPIC_MODEL=
ONTOFOUNDRY_ANTHROPIC_API_KEY=
# Required for Agent tasks. Point this to an external OpenDataWorks DataAgent.
ONTOFOUNDRY_DATAAGENT_BASE_URL=
ONTOFOUNDRY_DATAAGENT_API_PREFIX=/api/v1/nl2sql
ONTOFOUNDRY_DATAAGENT_WEBSITE_ID=ontofoundry
ONTOFOUNDRY_DATAAGENT_ACCESS_KEY=
ONTOFOUNDRY_DATAAGENT_AGENT_ID=agent_ontofoundry
ONTOFOUNDRY_DATAAGENT_REQUEST_TIMEOUT_SECONDS=30
ONTOFOUNDRY_DATAAGENT_EXECUTION_MODE=auto
# Fixed Fernet key; keep it backed up separately from the database.
ONTOFOUNDRY_CONNECTION_KEY=
ONTOFOUNDRY_MAX_FILE_MB=256
