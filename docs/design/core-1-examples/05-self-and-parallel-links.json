        "kind": "expression",
        "base_type_id": "00000000-0000-4000-8000-000000001404",
        "value_kind": "decimal",
        "expression": "SUM(CASE WHEN trade.buyer.region = '华东' AND trade.seller.region = '华南' THEN trade.amount ELSE 0 END)",
