{
  "$defs": {
    "AfterEvidenceLocator": {
      "additionalProperties": false,
      "properties": {
        "heading": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading"
        },
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        }
      },
      "required": [
        "line_start",
        "line_end"
      ],
      "title": "EvidenceLocator",
      "type": "object"
    },
    "AfterManualEvidence": {
      "additionalProperties": false,
      "description": "A member vouching for a fact. Author and time are written by the server.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "manual",
          "default": "manual",
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "default": "",
          "maxLength": 2000,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "id",
        "created_by",
        "created_at"
      ],
      "title": "ManualEvidence",
      "type": "object"
    },
    "AfterMaterialEvidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "material",
          "default": "material",
          "title": "Kind",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/AfterEvidenceLocator"
        },
        "material_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Material Id",
          "type": "string"
        },
        "material_sha256": {
          "title": "Material Sha256",
          "type": "string"
        },
        "quote": {
          "default": "",
          "maxLength": 2000,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "material_id",
        "locator"
      ],
      "title": "MaterialEvidence",
      "type": "object"
    },
    "AfterTableEvidenceInput": {
      "additionalProperties": false,
      "description": "Submission-only shorthand; persisted evidence is always MaterialEvidence.",
      "properties": {
        "kind": {
          "const": "table",
          "title": "Kind",
          "type": "string"
        },
        "quote": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "ref": {
          "maxLength": 500,
          "pattern": "^t[1-9][0-9]*(?:\\..+)?$",
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref",
        "quote"
      ],
      "title": "TableEvidenceInput",
      "type": "object"
    },
    "item": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "after": {
              "anyOf": [
                {
                  "$ref": "#/$defs/material_object_after"
                },
                {
                  "type": "null"
                }
              ]
            },
            "target_kind": {
              "const": "material_object"
            }
          }
        },
        {
          "properties": {
            "after": {
              "anyOf": [
                {
                  "$ref": "#/$defs/material_link_after"
                },
                {
                  "type": "null"
                }
              ]
            },
            "target_kind": {
              "const": "material_link"
            }
          }
        }
      ],
      "properties": {
        "after": {},
        "client_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
            "type": "string"
          },
          "maxItems": 50,
          "type": "array"
        },
        "evidence": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/AfterMaterialEvidence"
              },
              {
                "$ref": "#/$defs/AfterTableEvidenceInput"
              }
            ]
          },
          "maxItems": 50,
          "type": "array"
        },
        "field_changes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "after": {},
              "before": {},
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "type": "object"
          },
          "maxItems": 200,
          "type": "array"
        },
        "operation": {
          "enum": [
            "create",
            "update",
            "delete"
          ]
        },
        "reason": {
          "maxLength": 2000,
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_kind": {
          "enum": [
            "material_object",
            "material_link"
          ]
        }
      },
      "required": [
        "operation",
        "target_kind"
      ],
      "type": "object"
    },
    "material_link_after": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "discriminator": {
              "mapping": {
                "manual": "#/$defs/AfterManualEvidence",
                "material": "#/$defs/AfterMaterialEvidence",
                "table": "#/$defs/AfterTableEvidenceInput"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/AfterMaterialEvidence"
              },
              {
                "$ref": "#/$defs/AfterManualEvidence"
              },
              {
                "$ref": "#/$defs/AfterTableEvidenceInput"
              }
            ]
          },
          "maxItems": 50,
          "title": "Evidence",
          "type": "array"
        },
        "source_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "properties": {
                "client_ref": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
                  "type": "string"
                }
              },
              "required": [
                "client_ref"
              ],
              "type": "object"
            }
          ]
        },
        "target_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "properties": {
                "client_ref": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
                  "type": "string"
                }
              },
              "required": [
                "client_ref"
              ],
              "type": "object"
            }
          ]
        },
        "type_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "properties": {
                "client_ref": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
                  "type": "string"
                }
              },
              "required": [
                "client_ref"
              ],
              "type": "object"
            }
          ]
        }
      },
      "required": [
        "type_id",
        "source_id",
        "target_id"
      ],
      "title": "MaterialLink",
      "type": "object"
    },
    "material_object_after": {
      "additionalProperties": false,
      "description": "A document fact. Its display text is derived on read, not stored.",
      "properties": {
        "evidence": {
          "items": {
            "discriminator": {
              "mapping": {
                "manual": "#/$defs/AfterManualEvidence",
                "material": "#/$defs/AfterMaterialEvidence",
                "table": "#/$defs/AfterTableEvidenceInput"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/AfterMaterialEvidence"
              },
              {
                "$ref": "#/$defs/AfterManualEvidence"
              },
              {
                "$ref": "#/$defs/AfterTableEvidenceInput"
              }
            ]
          },
          "maxItems": 50,
          "title": "Evidence",
          "type": "array"
        },
        "type_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "properties": {
                "client_ref": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
                  "type": "string"
                }
              },
              "required": [
                "client_ref"
              ],
              "type": "object"
            }
          ]
        },
        "values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "type_id"
      ],
      "title": "MaterialObject",
      "type": "object"
    }
  },
  "$id": "https://ontofoundry.local/schemas/ontofoundry.proposals.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/item"
      },
      "maxItems": 500,
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "ontofoundry.proposals/v1",
  "type": "object"
}
