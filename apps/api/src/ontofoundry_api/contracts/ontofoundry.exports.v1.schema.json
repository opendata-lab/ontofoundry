{
  "$defs": {
    "TranslationIssue": {
      "additionalProperties": false,
      "properties": {
        "completion_status": {
          "default": "not_needed",
          "enum": [
            "not_needed",
            "available"
          ],
          "title": "Completion Status",
          "type": "string"
        },
        "construct": {
          "title": "Construct",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "original": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original"
        },
        "outcome": {
          "enum": [
            "converted",
            "dropped",
            "error"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_locator": {
          "additionalProperties": true,
          "title": "Source Locator",
          "type": "object"
        },
        "source_path": {
          "title": "Source Path",
          "type": "string"
        },
        "target_element_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Target Element Ids",
          "type": "array"
        },
        "target_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Path"
        }
      },
      "required": [
        "outcome",
        "construct",
        "id",
        "severity",
        "source_path",
        "source_locator",
        "message"
      ],
      "title": "TranslationIssue",
      "type": "object"
    },
    "TranslationReport": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "title": "Adapter",
          "type": "string"
        },
        "content_sha256": {
          "title": "Content Sha256",
          "type": "string"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "direction": {
          "enum": [
            "import",
            "export"
          ],
          "title": "Direction",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/TranslationIssue"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "id",
        "content_sha256",
        "direction",
        "adapter",
        "counts",
        "issues"
      ],
      "title": "TranslationReport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "title": "Adapter",
      "type": "string"
    },
    "content_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Content Sha256"
    },
    "download_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Download Url"
    },
    "filename": {
      "title": "Filename",
      "type": "string"
    },
    "media_type": {
      "title": "Media Type",
      "type": "string"
    },
    "report": {
      "$ref": "#/$defs/TranslationReport"
    },
    "version_id": {
      "format": "uuid",
      "title": "Version Id",
      "type": "string"
    }
  },
  "required": [
    "version_id",
    "adapter",
    "report",
    "content_sha256",
    "filename",
    "media_type",
    "download_url"
  ],
  "title": "ExportPreview",
  "type": "object"
}
