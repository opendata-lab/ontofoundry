{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ProposalCheckError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ProposalCheckError",
      "type": "object"
    },
    "UnacceptableGroup": {
      "additionalProperties": false,
      "properties": {
        "client_refs": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Client Refs",
          "type": "array"
        },
        "item_count": {
          "minimum": 1,
          "title": "Item Count",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "code": {
          "default": "PROPOSAL_GROUP_UNACCEPTABLE",
          "title": "Code",
          "type": "string"
        }
      },
      "required": [
        "client_refs",
        "item_count",
        "reason"
      ],
      "title": "UnacceptableGroup",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "contract_errors": {
      "items": {
        "$ref": "#/$defs/ProposalCheckError"
      },
      "title": "Contract Errors",
      "type": "array"
    },
    "unacceptable_groups": {
      "items": {
        "$ref": "#/$defs/UnacceptableGroup"
      },
      "title": "Unacceptable Groups",
      "type": "array"
    },
    "reviewable_count": {
      "minimum": 0,
      "title": "Reviewable Count",
      "type": "integer"
    },
    "unacceptable_count": {
      "minimum": 0,
      "title": "Unacceptable Count",
      "type": "integer"
    }
  },
  "required": [
    "passed",
    "contract_errors",
    "unacceptable_groups",
    "reviewable_count",
    "unacceptable_count"
  ],
  "title": "ProposalCheckResponse",
  "type": "object"
}
