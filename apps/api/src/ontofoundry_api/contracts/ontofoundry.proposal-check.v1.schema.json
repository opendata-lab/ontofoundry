{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ProposalCheckError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ProposalCheckError",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "contract_errors": {
      "items": {
        "$ref": "#/$defs/ProposalCheckError"
      },
      "title": "Contract Errors",
      "type": "array"
    },
    "reviewable_count": {
      "minimum": 0,
      "title": "Reviewable Count",
      "type": "integer"
    }
  },
  "required": [
    "passed",
    "contract_errors",
    "reviewable_count"
  ],
  "title": "ProposalCheckResponse",
  "type": "object"
}
