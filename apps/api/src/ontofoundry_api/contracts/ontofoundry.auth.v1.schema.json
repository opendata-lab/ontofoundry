{
  "$defs": {
    "AuthOptions": {
      "additionalProperties": false,
      "properties": {
        "local_login": {
          "title": "Local Login",
          "type": "boolean"
        },
        "oauth": {
          "anyOf": [
            {
              "$ref": "#/$defs/OAuthOption"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "local_login",
        "oauth"
      ],
      "title": "AuthOptions",
      "type": "object"
    },
    "CurrentUser": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Email"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "is_platform_admin": {
          "title": "Is Platform Admin",
          "type": "boolean"
        },
        "local_account": {
          "title": "Local Account",
          "type": "boolean"
        },
        "username": {
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "id",
        "username",
        "display_name",
        "email",
        "is_platform_admin",
        "local_account"
      ],
      "title": "CurrentUser",
      "type": "object"
    },
    "LocalLoginRequest": {
      "additionalProperties": false,
      "properties": {
        "password": {
          "title": "Password",
          "type": "string"
        },
        "username": {
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "username",
        "password"
      ],
      "title": "LocalLoginRequest",
      "type": "object"
    },
    "OAuthOption": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "OAuthOption",
      "type": "object"
    }
  },
  "$id": "ontofoundry.auth.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/AuthOptions"
    },
    {
      "$ref": "#/$defs/LocalLoginRequest"
    },
    {
      "$ref": "#/$defs/CurrentUser"
    }
  ]
}
