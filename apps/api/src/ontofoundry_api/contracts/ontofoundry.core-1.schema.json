{
  "$defs": {
    "Aggregation": {
      "enum": [
        "sum",
        "avg",
        "median",
        "min",
        "max",
        "count",
        "count_distinct"
      ],
      "title": "Aggregation",
      "type": "string"
    },
    "BindingMode": {
      "enum": [
        "independent",
        "shared_parent"
      ],
      "title": "BindingMode",
      "type": "string"
    },
    "ColumnBinding": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "kind": {
          "const": "column",
          "title": "Kind",
          "type": "string"
        },
        "source_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source_id",
        "column"
      ],
      "title": "ColumnBinding",
      "type": "object"
    },
    "ColumnReference": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "dataset_id": {
          "format": "uuid",
          "title": "Dataset Id",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "column"
      ],
      "title": "ColumnReference",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "$ref": "#/$defs/ColumnReference"
        },
        "operator": {
          "$ref": "#/$defs/Operator"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxItems": 200,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "column",
        "operator"
      ],
      "title": "Condition",
      "type": "object"
    },
    "DataMapping": {
      "additionalProperties": false,
      "properties": {
        "binding_mode": {
          "$ref": "#/$defs/BindingMode"
        },
        "fields": {
          "additionalProperties": {
            "discriminator": {
              "mapping": {
                "column": "#/$defs/ColumnBinding",
                "expression": "#/$defs/ExpressionBinding"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ColumnBinding"
              },
              {
                "$ref": "#/$defs/ExpressionBinding"
              }
            ]
          },
          "title": "Fields",
          "type": "object"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "inherited_link_bindings": {
          "additionalProperties": {
            "discriminator": {
              "mapping": {
                "direct": "#/$defs/DirectJoin",
                "mapping_table": "#/$defs/MappingTableJoin"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/DirectJoin"
              },
              {
                "$ref": "#/$defs/MappingTableJoin"
              }
            ]
          },
          "propertyNames": {
            "format": "uuid"
          },
          "title": "Inherited Link Bindings",
          "type": "object"
        },
        "membership_source_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Membership Source Id"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/MappingSource"
          },
          "maxItems": 64,
          "title": "Sources",
          "type": "array"
        },
        "type_id": {
          "format": "uuid",
          "title": "Type Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type_id",
        "binding_mode"
      ],
      "title": "DataMapping",
      "type": "object"
    },
    "Dataset": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/DatasetColumn"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Columns"
        },
        "connection_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connection Id"
        },
        "description": {
          "default": "",
          "maxLength": 8000,
          "title": "Description",
          "type": "string"
        },
        "dialect": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dialect"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "query_sql": {
          "anyOf": [
            {
              "maxLength": 65536,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Sql"
        },
        "schema_name": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Name"
        },
        "snapshot_date_column": {
          "anyOf": [
            {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Date Column"
        },
        "source_kind": {
          "default": "table",
          "enum": [
            "table",
            "query"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "table_name": {
          "anyOf": [
            {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Name"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Dataset",
      "type": "object"
    },
    "DatasetColumn": {
      "additionalProperties": false,
      "properties": {
        "comment": {
          "default": "",
          "maxLength": 2000,
          "title": "Comment",
          "type": "string"
        },
        "name": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "physical_type": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Physical Type"
        }
      },
      "required": [
        "name"
      ],
      "title": "DatasetColumn",
      "type": "object"
    },
    "DerivedExpression": {
      "additionalProperties": false,
      "properties": {
        "expression": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Expression",
          "type": "string"
        },
        "kind": {
          "const": "expression",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "expression"
      ],
      "title": "DerivedExpression",
      "type": "object"
    },
    "DerivedSimple": {
      "additionalProperties": false,
      "description": "One membership branch: every condition must hold (AND).",
      "properties": {
        "conditions": {
          "items": {
            "$ref": "#/$defs/PathCondition"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Conditions",
          "type": "array"
        },
        "kind": {
          "const": "simple",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "conditions"
      ],
      "title": "DerivedSimple",
      "type": "object"
    },
    "DirectJoin": {
      "additionalProperties": false,
      "description": "Source properties equal target properties, pair by pair.",
      "properties": {
        "kind": {
          "const": "direct",
          "title": "Kind",
          "type": "string"
        },
        "source_property_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Source Property Ids",
          "type": "array"
        },
        "target_property_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Target Property Ids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "source_property_ids",
        "target_property_ids"
      ],
      "title": "DirectJoin",
      "type": "object"
    },
    "EvidenceLocator": {
      "additionalProperties": false,
      "properties": {
        "heading": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading"
        },
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        }
      },
      "required": [
        "line_start",
        "line_end"
      ],
      "title": "EvidenceLocator",
      "type": "object"
    },
    "ExpressionBinding": {
      "additionalProperties": false,
      "description": "A same-row expression over this object's own sources (`source.column`).",
      "properties": {
        "expression": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Expression",
          "type": "string"
        },
        "kind": {
          "const": "expression",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "expression"
      ],
      "title": "ExpressionBinding",
      "type": "object"
    },
    "ExpressionMetric": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "format": "uuid",
          "title": "Dataset Id",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 8000,
          "title": "Description",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "evidence": {
          "items": {
            "discriminator": {
              "mapping": {
                "manual": "#/$defs/ManualEvidence",
                "material": "#/$defs/MaterialEvidence"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/MaterialEvidence"
              },
              {
                "$ref": "#/$defs/ManualEvidence"
              }
            ]
          },
          "maxItems": 50,
          "title": "Evidence",
          "type": "array"
        },
        "expression": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Expression",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "expression",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "synonyms": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Synonyms",
          "type": "array"
        },
        "time_field": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColumnReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValueKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "dataset_id",
        "expression"
      ],
      "title": "ExpressionMetric",
      "type": "object"
    },
    "LinkStep": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "forward",
            "reverse"
          ],
          "title": "Direction",
          "type": "string"
        },
        "link_type_id": {
          "format": "uuid",
          "title": "Link Type Id",
          "type": "string"
        }
      },
      "required": [
        "link_type_id",
        "direction"
      ],
      "title": "LinkStep",
      "type": "object"
    },
    "LinkType": {
      "additionalProperties": false,
      "properties": {
        "data_join": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "direct": "#/$defs/DirectJoin",
                  "mapping_table": "#/$defs/MappingTableJoin"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/DirectJoin"
                },
                {
                  "$ref": "#/$defs/MappingTableJoin"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Join"
        },
        "description": {
          "default": "",
          "maxLength": 8000,
          "title": "Description",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "evidence": {
          "items": {
            "discriminator": {
              "mapping": {
                "manual": "#/$defs/ManualEvidence",
                "material": "#/$defs/MaterialEvidence"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/MaterialEvidence"
              },
              {
                "$ref": "#/$defs/ManualEvidence"
              }
            ]
          },
          "maxItems": 50,
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "multiplicity": {
          "$ref": "#/$defs/Multiplicity"
        },
        "name": {
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "source_role_name": {
          "anyOf": [
            {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Role Name"
        },
        "source_type_id": {
          "format": "uuid",
          "title": "Source Type Id",
          "type": "string"
        },
        "synonyms": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Synonyms",
          "type": "array"
        },
        "tags": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Tags",
          "type": "array"
        },
        "target_role_name": {
          "anyOf": [
            {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Role Name"
        },
        "target_type_id": {
          "format": "uuid",
          "title": "Target Type Id",
          "type": "string"
        },
        "verbalizes": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "pattern": "^(?=[\\s\\S]*\\{source\\})(?=[\\s\\S]*\\{target\\})(?:[^{}]|\\{(?:source|target)\\})*$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Verbalizes",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "source_type_id",
        "target_type_id",
        "multiplicity"
      ],
      "title": "LinkType",
      "type": "object"
    },
    "ManualEvidence": {
      "additionalProperties": false,
      "description": "A member vouching for a fact. Author and time are written by the server.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "manual",
          "default": "manual",
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "default": "",
          "maxLength": 2000,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "id",
        "created_by",
        "created_at"
      ],
      "title": "ManualEvidence",
      "type": "object"
    },
    "MappingKey": {
      "additionalProperties": false,
      "description": "The end object's main source `key_columns`.",
      "properties": {
        "kind": {
          "const": "mapping_key",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "MappingKey",
      "type": "object"
    },
    "MappingSource": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "format": "uuid",
          "title": "Dataset Id",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "key_columns": {
          "items": {
            "maxLength": 240,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Key Columns",
          "type": "array"
        }
      },
      "required": [
        "id",
        "dataset_id"
      ],
      "title": "MappingSource",
      "type": "object"
    },
    "MappingTableJoin": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "format": "uuid",
          "title": "Dataset Id",
          "type": "string"
        },
        "kind": {
          "const": "mapping_table",
          "title": "Kind",
          "type": "string"
        },
        "source_columns": {
          "items": {
            "maxLength": 240,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Source Columns",
          "type": "array"
        },
        "source_key": {
          "discriminator": {
            "mapping": {
              "mapping_key": "#/$defs/MappingKey",
              "properties": "#/$defs/PropertiesKey"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/MappingKey"
            },
            {
              "$ref": "#/$defs/PropertiesKey"
            }
          ],
          "title": "Source Key"
        },
        "target_columns": {
          "items": {
            "maxLength": 240,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Target Columns",
          "type": "array"
        },
        "target_key": {
          "discriminator": {
            "mapping": {
              "mapping_key": "#/$defs/MappingKey",
              "properties": "#/$defs/PropertiesKey"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/MappingKey"
            },
            {
              "$ref": "#/$defs/PropertiesKey"
            }
          ],
          "title": "Target Key"
        }
      },
      "required": [
        "kind",
        "dataset_id",
        "source_columns",
        "target_columns",
        "source_key",
        "target_key"
      ],
      "title": "MappingTableJoin",
      "type": "object"
    },
    "MaterialEvidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "material",
          "default": "material",
          "title": "Kind",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/EvidenceLocator"
        },
        "material_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Material Id",
          "type": "string"
        },
        "material_sha256": {
          "title": "Material Sha256",
          "type": "string"
        },
        "quote": {
          "default": "",
          "maxLength": 2000,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "id",
        "material_id",
        "material_sha256",
        "locator"
      ],
      "title": "MaterialEvidence",
      "type": "object"
    },
    "MaterialLink": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "discriminator": {
              "mapping": {
                "manual": "#/$defs/ManualEvidence",
                "material": "#/$defs/MaterialEvidence"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/MaterialEvidence"
              },
              {
                "$ref": "#/$defs/ManualEvidence"
              }
