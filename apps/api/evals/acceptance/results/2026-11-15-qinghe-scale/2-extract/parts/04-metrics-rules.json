 {
  "operation": "create",
  "target_kind": "rule",
  "client_ref": "sales_order_amount_derivation",
  "after": {
   "name": "sales_order_amount_derivation",
   "display_name": "实付金额构成",
   "owner_kind": "object_type",
   "owner_id": {
    "client_ref": "sales_order"
   },
   "rule_kind": "derivation",
   "expression": "sales_order.pay_amount = sales_order.gross_amount - sales_order.discount_amount - sales_order.coupon_amount",
   "description": "实付金额由商品原价合计减促销优惠再减优惠券抵扣得到；空值按 0 参与计算，需人工确认是否存在其他调整项"
  }
