      "operation": "create",
      "target_kind": "dataset",
      "target_id": "b1fb8b9e-9533-5a9a-a02b-1c1868734e78",
      "display_name": "按日销售与退款数据",
      "owner_label": null,
      "before": null,
      "after": {
        "id": "b1fb8b9e-9533-5a9a-a02b-1c1868734e78",
        "name": "sales_refund_daily",
        "display_name": "按日销售与退款数据",
        "connection_id": "e3225870-9233-416f-9134-a6ec8dc3ad1f",
        "source_kind": "query",
        "dialect": "mysql",
        "schema_name": null,
        "table_name": null,
        "query_sql": "SELECT d.event_date, SUM(d.sales_amount) AS sales_amount, SUM(d.refund_amount) AS refund_amount FROM (SELECT o.order_date AS event_date, o.pay_amount AS sales_amount, 0 AS refund_amount FROM xinghe_retail.orders o WHERE o.status = '已完成' UNION ALL SELECT r.refund_date AS event_date, 0 AS sales_amount, r.refund_amount AS refund_amount FROM xinghe_retail.refunds r) d GROUP BY d.event_date",
        "description": "把销售额与退款金额按各自业务日期对齐到同一日期轴，供退款率在同一数据集内计算；两路各自带日期，避免多笔退款重复累计销售额",
        "snapshot_date_column": null,
        "columns": [
          {
            "name": "event_date",
            "physical_type": "DATE",
            "comment": "业务日期：销售取订单下单日期，退款取退款日期"
          },
          {
            "name": "sales_amount",
            "physical_type": "DECIMAL(12,2)",
            "comment": "当日已完成订单实付金额合计"
          },
          {
            "name": "refund_amount",
            "physical_type": "DECIMAL(12,2)",
            "comment": "当日退款金额合计"
          }
        ]
      },
